[{"id":1781857776623,"text":"那些乱七八糟的假设，以后不许再提了。","rawContent":"那些乱七八糟的假设，以后不许再提了。","isHtml":false,"sticker":null,"sender":"them","time":"22:47","timestamp":1781880457888,"roundId":"round_1781880418363_enzvv46iz","generatedMode":false,"translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":10785},{"id":1781857776624,"text":"本官可舍不得用这种低劣的骗术去弄哭你。","rawContent":"本官可舍不得用这种低劣的骗术去弄哭你。","isHtml":false,"sticker":null,"sender":"them","time":"22:47","timestamp":1781880462877,"roundId":"round_1781880418363_enzvv46iz","generatedMode":false,"translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":10786},{"id":1781857776625,"text":"他停顿了一下，嘴角重新勾起一抹暧昧不明的弧度，眼神变得深邃而充满侵略性。","rawContent":"他停顿了一下，嘴角重新勾起一抹暧昧不明的弧度，眼神变得深邃而充满侵略性。","isHtml":false,"sticker":null,"sender":"them","time":"22:47","timestamp":1781880465846,"roundId":"round_1781880418363_enzvv46iz","generatedMode":false,"type":"state","translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":10787},{"id":1781857776626,"text":"要是你真想体会一下为本官哭泣的感觉……","rawContent":"要是你真想体会一下为本官哭泣的感觉……","isHtml":false,"sticker":null,"sender":"them","time":"22:47","timestamp":1781880471240,"roundId":"round_1781880418363_enzvv46iz","generatedMode":false,"translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":10788},{"id":1781857776627,"text":"以后有机会，本官一定亲手、在床上，把你弄哭。","rawContent":"以后有机会，本官一定亲手、在床上，把你弄哭。","isHtml":false,"sticker":null,"sender":"them","time":"22:47","timestamp":1781880476263,"roundId":"round_1781880418363_enzvv46iz","generatedMode":false,"translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":10789},{"id":1781881266162,"text":"我给你换了新头像","sender":"me","time":"23:02","timestamp":1781881346786,"replyTo":null,"userId":"uid_1778159494233_wkl8keakk","cha