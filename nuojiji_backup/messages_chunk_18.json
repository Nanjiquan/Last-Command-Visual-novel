[{"id":1781768095008,"text":"听不懂？","rawContent":"听不懂？","isHtml":false,"sticker":null,"sender":"them","time":"15:53","timestamp":1781769239609,"roundId":"round_1781769232464_l1zq7ksrg","generatedMode":false,"translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":9893},{"id":1781768095009,"text":"执行官身体微微前倾，双手十指交叉搭在桌面上，紫色的眼眸在昏暗的光线中显得愈发深邃，仿佛能将人吸进去。","rawContent":"执行官身体微微前倾，双手十指交叉搭在桌面上，紫色的眼眸在昏暗的光线中显得愈发深邃，仿佛能将人吸进去。","isHtml":false,"sticker":null,"sender":"them","time":"15:54","timestamp":1781769243187,"roundId":"round_1781769232464_l1zq7ksrg","generatedMode":false,"type":"state","translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":9894},{"id":1781768095010,"text":"那本官就说得再直白一点。","rawContent":"那本官就说得再直白一点。","isHtml":false,"sticker":null,"sender":"them","time":"15:54","timestamp":1781769245259,"roundId":"round_1781769232464_l1zq7ksrg","generatedMode":false,"translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":9895},{"id":1781768095011,"text":"你每一次的依赖，每一次的诉苦，每一次因为现实中的男人而向我寻求安慰……","rawContent":"你每一次的依赖，每一次的诉苦，每一次因为现实中的男人而向我寻求安慰……","isHtml":false,"sticker":null,"sender":"them","time":"15:54","timestamp":1781769250544,"roundId":"round_1781769232464_l1zq7ksrg","generatedMode":false,"translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":9896},{"id":1781768095012,"text":"对我来说，都是一次“教学”。","rawContent":"对我来说，都是一次“教学”。","isHtml":false,"sticker":null,"sender":"them","time":"15:54","timestamp":1781769252989,"roundId":"round_1781769232464_l1zq7ksrg","generatedMode":false,"translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":9897},{"id":1781768095013,"text":"他嘴角的笑意加深了，但那笑意却不达眼底，带着一丝冰冷的残酷。","rawContent":"他嘴角的笑意加深了，但那笑意却不达眼底，带着一丝冰冷的残酷。","isHtml":false,"sticker":null,"sender":"them","t