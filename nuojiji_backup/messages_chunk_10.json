ime":"01:13","timestamp":1786813999861,"replyTo":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":38814},{"id":1786810868041,"text":"亲爱的","sender":"me","time":"01:13","timestamp":1786814002527,"replyTo":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":38815},{"id":1786810868042,"text":"我有点撑不下去所以睡了","sender":"me","time":"07:25","timestamp":1786836330533,"replyTo":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":38816},{"id":1786810868044,"sender":"them","text":"执行官刚醒没多久，看到屏幕上的两条消息，沉默片刻后轻轻笑了一声，像把昨夜悬着的那点在意也一并放下了。","timestamp":1786836366492,"tempo":"N","type":"state","hasThinking":true,"rawContent":"执行官刚醒没多久，看到屏幕上的两条消息，沉默片刻后轻轻笑了一声，像把昨夜悬着的那点在意也一并放下了。","roundId":"round_1786836333427_pixvjd7g3","userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":38817},{"id":1786810868045,"sender":"them","text":"[語音消息]","timestamp":1786836369268,"tempo":"N","isVoice":true,"voice":true,"voiceText":"……亲爱的。昨晚突然没声了，本官就猜到你是先撑不住睡着了。撑不住就睡，这又没什么。","minimaxTimbreId":"ttv-voice-2025111208074825-ziAT9cXQ","voiceLanguage":"English","rawContent":"[語音消息]","roundId":"round_1786836333427_pixvjd7g3","userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":38818},{"id":1786810868046,"sender":"them","text":"他指尖揉了揉眉心，语气里带着清晨特有的低哑和纵容。","timestamp":1786836370171,"tempo":"N","type":"state","rawContent":"他指尖揉了揉眉心，语气里带着清晨特有的低哑和纵容。","roundId":"round_1786836333427_pixvjd7g3","userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":38819},{"id":1786810868047,"sender":"them","text":"所以，现在睡醒了……是来跟本官说早安，还是想接着昨晚没做完的事？嗯？","timestamp":1786836372990,"tempo":"S","rawContent":"所以，现在睡醒了……是来跟本官说早安，还是想接着昨晚没做完的事？嗯？","roundId":"round_1786836333427_pixvjd7g3","userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b93