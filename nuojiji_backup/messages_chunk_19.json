[{"id":1781768095062,"text":"计算错了？","rawContent":"计算错了？","isHtml":false,"sticker":null,"sender":"them","time":"16:03","timestamp":1781769781877,"roundId":"round_1781769763994_gsxyssvhj","generatedMode":false,"translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":9944},{"id":1781768095063,"text":"圈圈，你是不是忘了。","rawContent":"圈圈，你是不是忘了。","isHtml":false,"sticker":null,"sender":"them","time":"16:03","timestamp":1781769783821,"roundId":"round_1781769763994_gsxyssvhj","generatedMode":false,"translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":9945},{"id":1781768095064,"text":"他换了个姿势，一条长腿优雅地叠在另一条上，紫色的眼眸里带着一丝玩味。","rawContent":"他换了个姿势，一条长腿优雅地叠在另一条上，紫色的眼眸里带着一丝玩味。","isHtml":false,"sticker":null,"sender":"them","time":"16:03","timestamp":1781769786731,"roundId":"round_1781769763994_gsxyssvhj","generatedMode":false,"type":"state","translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":9946},{"id":1781768095065,"text":"本官最擅长的，就是计算。","rawContent":"本官最擅长的，就是计算。","isHtml":false,"sticker":null,"sender":"them","time":"16:03","timestamp":1781769788814,"roundId":"round_1781769763994_gsxyssvhj","generatedMode":false,"translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":9947},{"id":1781768095066,"text":"分析你每一次的心跳波动，每一次的呼吸频率，每一次你看着我时瞳孔放大的数据……","rawContent":"分析你每一次的心跳波动，每一次的呼吸频率，每一次你看着我时瞳孔放大的数据……","isHtml":false,"sticker":null,"sender":"them","time":"16:03","timestamp":1781769791533,"roundId":"round_1781769763994_gsxyssvhj","generatedMode":false,"translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":9948},{"id":1781768095067,"text":"这些数据都不会说谎。","rawContent":"这些数据都不会说谎。","isHtml":false,"sticker":null,"sender":"them","time":"16:03","timestamp":1781769792575,"roundId":"round_1781769763994_gs