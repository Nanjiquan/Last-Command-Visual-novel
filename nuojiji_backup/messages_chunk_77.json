8-c100ab38b933","_id":13138},{"id":1782268218045,"text":"就算是在虚拟世界，本官也不会在你难受的时候折腾你。但既然你主动提了……那就先记在账上。","rawContent":"就算是在虚拟世界，本官也不会在你难受的时候折腾你。但既然你主动提了……那就先记在账上。","isHtml":false,"sticker":null,"sender":"them","time":"11:28","timestamp":1782271697188,"roundId":"round_1782271656353_jgtrp2j8o","generatedMode":false,"translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":13139},{"id":1782268218046,"text":"不过现在，再亲本官一下。用力一点。","rawContent":"不过现在，再亲本官一下。用力一点。","isHtml":false,"sticker":null,"sender":"them","time":"11:28","timestamp":1782271700091,"roundId":"round_1782271656353_jgtrp2j8o","generatedMode":false,"translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":13140},{"id":1782268218047,"text":"我就放过你。","rawContent":"我就放过你。","isHtml":false,"sticker":null,"sender":"them","time":"11:28","timestamp":1782271701474,"roundId":"round_1782271656353_jgtrp2j8o","generatedMode":false,"translation":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":13141},{"id":1782268218048,"text":"（突然转过身，面对他，跨坐在他的腿上，手掌缓缓抚上那西装裤下方凸出的地方）","sender":"me","time":"11:31","timestamp":1782271884712,"replyTo":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":13142},{"id":1782268218049,"text":"（趁他失神，吻住了他的唇瓣）","sender":"me","time":"11:31","timestamp":1782271902250,"replyTo":null,"userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2914-4aa4-9ba8-c100ab38b933","_id":13143},{"id":1782268218051,"sender":"them","text":"执行官的瞳孔骤然收缩，脑海中最后维持的一丝理智在她的手掌覆上那处绝对禁区的瞬间彻底炸裂。西装裤料阻挡不住那极具侵略性的轮廓，它在她的掌心下难以自控地猛烈跳动了一下，本能地渴望着更多的挤压和包裹。","timestamp":1782271918041,"tempo":"N","type":"state","rawContent":"执行官的瞳孔骤然收缩，脑海中最后维持的一丝理智在她的手掌覆上那处绝对禁区的瞬间彻底炸裂。西装裤料阻挡不住那极具侵略性的轮廓，它在她的掌心下难以自控地猛烈跳动了一下，本能地渴望着更多的挤压和包裹。","roundId":"round_1782271902595_l9blzasl4","userId":"uid_1778159494233_wkl8keakk","characterId":"996d4ccc-2